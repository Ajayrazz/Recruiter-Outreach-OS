# Copy to .env. No secrets belong in git.
# Where the database, resumes, encrypted tokens, backups live (default ./data)
RECRUITER_OS_DATA_DIR=./data
# Path to the OAuth client JSON downloaded from Google Cloud Console (Desktop app type)
GOOGLE_CLIENT_SECRET_FILE=./data/secrets/client_secret.json
# Local port used for the one-time OAuth redirect on 127.0.0.1
OAUTH_LOCAL_PORT=8765
# Optional: master key for token encryption. If unset, a key is kept in the macOS Keychain
# (fallback: a 0600 key file in data/secrets).
RECRUITER_OS_SECRET_KEY=
# true = NO real email is ever sent to recruiters; sends only go to TEST_RECIPIENT
RECRUITER_OS_TEST_MODE=true
# Optional AI-assisted drafting (never needed to send). Provider: none | anthropic
AI_PROVIDER=none
AI_API_KEY=
LOG_LEVEL=INFO
